# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put real tokens / passwords into an (untracked) .env.local instead.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
# Default to prod so a misconfigured server never boots in dev. Override to dev in .env.local locally.
APP_ENV=prod
APP_SECRET=CHANGE_ME_IN_ENV_LOCAL
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Local dev default. Real prod credentials go into .env.local (never committed).
DATABASE_URL="mysql://root:@localhost/kntntbot?charset=utf8mb4&serverVersion=mariadb-10.8.4"
###< doctrine/doctrine-bundle ###

###> app/telegram ###
# Real values live in .env.local (untracked).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vlogkntntbot
# Chat/channel id the import command uploads to once, to obtain a reusable file_id.
TELEGRAM_STORAGE_CHAT_ID=
# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token header.
# Set the same value when calling setWebhook(secret_token=...). Empty = check disabled.
TELEGRAM_WEBHOOK_SECRET=
###< app/telegram ###
