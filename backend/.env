# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# Put real tokens / passwords into an (untracked) .env.local instead.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
# Default to prod so a misconfigured server never boots in dev. Override to dev in .env.local locally.
APP_ENV=prod
APP_SECRET=CHANGE_ME_IN_ENV_LOCAL
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Local dev default. Real prod credentials go into .env.local (never committed).
DATABASE_URL="mysql://root:@localhost/kntntbot?charset=utf8mb4&serverVersion=mariadb-10.8.4"
###< doctrine/doctrine-bundle ###

# Telegram bot credentials (token, username, storage chat, webhook token) are
# per-bot and stored in the database (App\Entity\Bot) — this one host serves
# many bots. Manage them via `app:bot:create` / the admin panel.

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Real passphrase lives in .env.local. Each environment has its own keypair + passphrase.
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
